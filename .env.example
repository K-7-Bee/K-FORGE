# Server-side only. These are read by server/index.mjs and never shipped to the browser.
# AI Engineering Mentor (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Code execution via Judge0 (optional). Self-hosted: JUDGE0_URL=http://localhost:2358
# RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com and set JUDGE0_RAPIDAPI_KEY
JUDGE0_URL=
JUDGE0_RAPIDAPI_KEY=
PORT=8787

# Cloud sync (optional, Supabase). These are public by design: row-level security in
# supabase/schema.sql restricts every row and file to its owner. Rebuild after changing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push reminders (optional). If unset, the server generates keys in server/data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
